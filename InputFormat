using System;
using System.Globalization;
using System.IO;
using System.Text.Json;

partial class Program
{
    private static string ReadNonEmpty(string errorMessage)
        {
            while (true)
            {
                string value = Console.ReadLine()?.Trim() ?? "";
                if (!string.IsNullOrWhiteSpace(value))
                    return value;
    
                Console.WriteLine(errorMessage);
                Console.Write("Coba lagi: ");
            }
        }

    private static int ReadInt(string prompt, int min, int max)
        {
            while (true)
            {
                Console.Write(prompt);
                string input = Console.ReadLine()?.Trim() ?? "";
    
                if (int.TryParse(input, out int value) && value >= min && value <= max)
                    return value;
    
                Console.WriteLine($"Masukkan angka antara {min} dan {max}.");
            }
        }

    private static DateTime ReadDate(string prompt)
        {
            while (true)
            {
                Console.Write(prompt);
                string input = Console.ReadLine()?.Trim() ?? "";
    
                if (DateTime.TryParseExact(input, "yyyy-MM-dd", CultureInfo.InvariantCulture,
                    DateTimeStyles.None, out DateTime date))
                    return date.Date;
    
                Console.WriteLine("Format tanggal salah. Gunakan format yyyy-MM-dd, contoh 2026-10-30.");
            }
        }

}
