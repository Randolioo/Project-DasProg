    private static void ShowAllBookings()
    {
        if (data.Bookings.Length == 0)
        {
            Console.WriteLine("Belum ada data booking.");
            return;
        }

        Console.WriteLine("SEMUA DATA BOOKING");

        // Salin array agar urutan data utama tidak berubah.
        Booking[] sortedBookings = new Booking[data.Bookings.Length];
        for (int i = 0; i < data.Bookings.Length; i++)
            sortedBookings[i] = data.Bookings[i];

        // Pengurutan manual berdasarkan tanggal, lalu jam mulai.
        for (int i = 0; i < sortedBookings.Length - 1; i++)
        {
            for (int j = i + 1; j < sortedBookings.Length; j++)
            {
                bool shouldSwap = string.Compare(sortedBookings[i].Date, sortedBookings[j].Date, StringComparison.Ordinal) > 0;
                if (!shouldSwap && sortedBookings[i].Date == sortedBookings[j].Date)
                    shouldSwap = sortedBookings[i].StartHour > sortedBookings[j].StartHour;

                if (shouldSwap)
                {
                    Booking temp = sortedBookings[i];
                    sortedBookings[i] = sortedBookings[j];
                    sortedBookings[j] = temp;
                }
            }
        }

        for (int i = 0; i < sortedBookings.Length; i++)
            PrintBooking(sortedBookings[i]);
    }

    private static void CancelBookingFlow(string? currentUsername, bool isAdmin)
    {
        Console.Write("Kode booking yang akan dibatalkan: ");
        string code = ReadNonEmpty("Kode booking tidak boleh kosong.");

        Booking? booking = null;
        for (int i = 0; i < data.Bookings.Length; i++)
        {
            if (data.Bookings[i].Code.Equals(code, StringComparison.OrdinalIgnoreCase))
            {
                booking = data.Bookings[i];
                break;
            }
        }
        if (booking == null)
        {
            Console.WriteLine("Booking tidak ditemukan.");
            return;
        }

        if (!isAdmin && !booking.Username.Equals(currentUsername, StringComparison.OrdinalIgnoreCase))
        {
            Console.WriteLine("Customer hanya dapat membatalkan booking miliknya sendiri.");
            return;
        }

        if (booking.Status != "Booked")
        {
            Console.WriteLine("Booking ini sudah dibatalkan sebelumnya.");
            return;
        }

        PrintBooking(booking);
        Console.Write("Yakin membatalkan booking ini? (Y/N): ");
        if ((Console.ReadLine()?.Trim().ToUpperInvariant() ?? "N") != "Y")
        {
            Console.WriteLine("Pembatalan dibatalkan.");
            return;
        }

        booking.Status = "Cancelled";
        if (booking.PaymentStatus == "Paid")
            booking.PaymentStatus = "Refunded (simulasi)";

        // Bola yang dibeli dikembalikan ke stok cabang terkait sebagai simulasi refund pembatalan.
        int branchIndex = GetBranchIndex(booking.Branch);
        if (branchIndex >= 0)
            data.BallStocks[branchIndex] += booking.BallCount;

        if (booking.BallCount > 0)
            RecordInventoryChange(booking.Branch, "BALL", booking.BallCount, "Pengembalian bola dari pembatalan " + booking.Code);

        SaveData();
        Console.WriteLine("Booking dibatalkan. Stok bola dikembalikan dan refund sudah dilakukan.");
    }
}
